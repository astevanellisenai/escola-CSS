<%- include('../includes/header.ejs', { titulo: 'Editar Disciplina' }) %>

<main class="p-4 md:p-6 bg-neutra-50 min-h-screen flex flex-col items-center justify-center">
  <div class="bg-white rounded-xl shadow-lg p-6 w-full max-w-md border border-gray-200">
    <h2 class="text-2xl font-semibold text-sistema-700 mb-6 text-center">Editar Disciplina</h2>

    <form action="/disciplinas/<%= disciplina.id_disciplina %>/editar" method="POST" class="flex flex-col gap-4">
      <div>
        <label for="nome_disciplina" class="block text-sm font-medium text-gray-700 mb-1">Nome da Disciplina</label>
        <input type="text" id="nome_disciplina" name="nome_disciplina" required
               value="<%= disciplina.nome_disciplina %>"
               class="w-full border border-gray-300 rounded-md px-3 py-2 focus:ring-2 focus:ring-sistema-500 focus:border-sistema-500 outline-none"/>
      </div>

      <div>
        <label for="id_professor" class="block text-sm font-medium text-gray-700 mb-1">Professor</label>
        <select id="id_professor" name="id_professor"
                class="w-full border border-gray-300 rounded-md px-3 py-2 focus:ring-2 focus:ring-sistema-500 focus:border-sistema-500 outline-none">
          <% for (let p of professoresCadastrados) { %>
            <option value="<%= p.id_professor %>" <%= Number(disciplina.id_professor)===Number(p.id_professor)?'selected':'' %>><%= p.nome_professor %></option>
          <% } %>
        </select>
      </div>

      <div class="flex justify-end gap-3 mt-4">
        <a href="/disciplinas" class="px-4 py-2 rounded-md bg-gray-400 text-white hover:bg-gray-500 transition">Cancelar</a>
        <button type="submit" class="px-4 py-2 rounded-md bg-sistema-600 text-white hover:bg-sistema-700 transition">Salvar</button>
      </div>
    </form>
  </div>
</main>

<%- include('../includes/footer.ejs') %>
