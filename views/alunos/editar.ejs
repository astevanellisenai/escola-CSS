<%- include('../includes/header.ejs', { titulo: 'Editar Aluno' }) %>

<main class="p-4 md:p-6 bg-neutra-50 min-h-screen flex flex-col items-center justify-center">
  <div class="bg-white rounded-xl shadow-lg p-6 w-full max-w-md border border-gray-200">
    <h2 class="text-2xl font-semibold text-sistema-700 mb-6 text-center">Editar Aluno</h2>

    <% if (typeof mensagem !== 'undefined' && mensagem) { %>
      <p class="text-red-600 mb-4"><%= mensagem %></p>
    <% } %>

    <form action="/alunos/<%= aluno.id_aluno %>/editar" method="POST" class="flex flex-col gap-4">
      <div>
        <label for="nome" class="block text-sm font-medium text-gray-700 mb-1">Nome</label>
        <input type="text" id="nome" name="nome" required
               value="<%= aluno.nome %>"
               class="w-full border border-gray-300 rounded-md px-3 py-2 focus:ring-2 focus:ring-sistema-500 focus:border-sistema-500 outline-none"/>
      </div>

      <div>
        <label for="idade" class="block text-sm font-medium text-gray-700 mb-1">Idade</label>
        <input type="number" id="idade" name="idade" min="0" required
               value="<%= aluno.idade %>"
               class="w-full border border-gray-300 rounded-md px-3 py-2 focus:ring-2 focus:ring-sistema-500 focus:border-sistema-500 outline-none"/>
      </div>

      <div>
        <label for="sexo" class="block text-sm font-medium text-gray-700 mb-1">Sexo</label>
        <select id="sexo" name="sexo" required
                class="w-full border border-gray-300 rounded-md px-3 py-2 focus:ring-2 focus:ring-sistema-500 focus:border-sistema-500 outline-none">
          <option value="M" <%= aluno.sexo === 'M' ? 'selected' : '' %> >Masculino</option>
          <option value="F" <%= aluno.sexo === 'F' ? 'selected' : '' %> >Feminino</option>
        </select>
      </div>

      <div>
        <label for="id_turma" class="block text-sm font-medium text-gray-700 mb-1">Turma</label>
        <select id="id_turma" name="id_turma" required
                class="w-full border border-gray-300 rounded-md px-3 py-2 focus:ring-2 focus:ring-sistema-500 focus:border-sistema-500 outline-none">
          <% for (let t of turmas) { %>
            <option value="<%= t.id_turma %>" <%= Number(aluno.id_turma) === Number(t.id_turma) ? 'selected' : '' %> >
              <%= t.nome_turma %>
            </option>
          <% } %>
        </select>
      </div>

      <div class="flex justify-end gap-3 mt-4">
        <a href="/alunos" class="px-4 py-2 rounded-md bg-gray-400 text-white hover:bg-gray-500 transition">Cancelar</a>
        <button type="submit" class="px-4 py-2 rounded-md bg-sistema-600 text-white hover:bg-sistema-700 transition">Atualizar</button>
      </div>
    </form>
  </div>
</main>

<%- include('../includes/footer.ejs') %>
