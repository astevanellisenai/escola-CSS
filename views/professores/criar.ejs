<%- include('../includes/header.ejs', { titulo: 'Adicionar Professor' }) %>

<main class="p-4 md:p-6 bg-neutra-50 min-h-screen">
  <section class="max-w-xl mx-auto bg-white rounded-lg shadow-md border border-gray-200 p-4 md:p-6">
    <h2 class="text-lg md:text-xl font-semibold text-sistema-700 mb-4">Adicionar Professor</h2>

    <form action="/professores/novo" method="POST" class="grid gap-4">
      <div>
        <label for="nome_professor" class="block text-sm font-medium text-gray-700 mb-1">Nome</label>
        <input id="nome_professor" name="nome_professor" required
               class="w-full rounded-md border border-gray-300 px-3 py-2 outline-none focus:ring-2 focus:ring-sistema-500" />
      </div>

      <div>
        <label for="telefone" class="block text-sm font-medium text-gray-700 mb-1">Telefone</label>
        <input id="telefone" name="telefone" required
               class="w-full rounded-md border border-gray-300 px-3 py-2 outline-none focus:ring-2 focus:ring-sistema-500" />
      </div>

      <div>
        <label for="formacao" class="block text-sm font-medium text-gray-700 mb-1">Formação</label>
        <input id="formacao" name="formacao"
               class="w-full rounded-md border border-gray-300 px-3 py-2 outline-none focus:ring-2 focus:ring-sistema-500" />
      </div>

      <div class="flex justify-end gap-3">
        <a href="/professores" class="px-4 py-2 rounded-md bg-neutra-200 hover:bg-neutra-300">Cancelar</a>
        <button type="submit" class="px-4 py-2 rounded-md bg-sistema-600 hover:bg-sistema-700 text-white">Salvar</button>
      </div>
    </form>
  </section>
</main>

<%- include('../includes/footer.ejs') %>
