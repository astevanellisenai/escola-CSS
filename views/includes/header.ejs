<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sistema Escolar - <%= titulo %></title>

  <!-- CSS local -->
  <link rel="stylesheet" href="/css/style.css" />

  <!-- Chart.js (UMD) expõe window.Chart -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
</head>

<body class="bg-neutra-50">
  <!-- Header com degradê vermelho -->
  <header class="bg-gradient-to-r from-sistema-800 via-sistema-700 to-sistema-500 text-white shadow-md border-b border-white/30">
    <div class="max-w-7xl mx-auto px-6 py-3">
      <!-- Linha 1: título fixo + usuário -->
      <div class="flex items-center justify-between">
        <h1 class="text-2xl font-bold tracking-wide">Sistema Escolar</h1>

        <% if (typeof nomeUsuario !== 'undefined' && nomeUsuario) { %>
          <p class="text-sm opacity-90">
            Bem-vindo, <span class="font-semibold"><%= nomeUsuario %></span>
          </p>
        <% } %>
      </div>

      <!-- Linha 2: título da página + menu -->
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mt-2">
        <h2 class="text-base sm:text-lg font-semibold text-sistema-50 drop-shadow-sm text-center sm:text-left">
          <%= titulo %>
        </h2>

        <nav class="flex items-center gap-4 text-sm tracking-wide mt-2 sm:mt-0">
          <a href="/admin" class="hover:text-sistema-200 transition">Dashboard</a>
          <span class="opacity-70">|</span>
          <a href="/professores/" class="hover:text-sistema-200 transition">Professores</a>
          <span class="opacity-70">|</span>
          <a href="/turmas/" class="hover:text-sistema-200 transition">Turmas</a>
          <span class="opacity-70">|</span>
          <a href="/disciplinas/" class="hover:text-sistema-200 transition">Disciplinas</a>
          <span class="opacity-70">|</span>
          <a href="/alunos/" class="hover:text-sistema-200 transition">Alunos</a>
         
 
         <% if (is_admin) { %>
          <span class="opacity-70">|</span>
          <a href="/usuarios/" class="hover:text-sistema-200 transition">Usuários</a>
         <% } %>

          <span class="opacity-70">|</span>
                  <a href="/notas/" class="hover:text-sistema-200 transition">Notas</a>
          <span class="opacity-70">|</span>
          <a href="/auth/logout" class="hover:text-sistema-200 transition">Sair</a>
        </nav>
      </div>
    </div>
  </header>
