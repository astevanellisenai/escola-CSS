<%- include('../includes/header.ejs', { titulo: (typeof titulo !== 'undefined' ? titulo : 'Editar Nota') }) %>

<main class="p-4 md:p-6 bg-neutra-50 min-h-screen flex flex-col items-center justify-center">
  <div class="bg-white rounded-xl shadow-lg p-6 w-full max-w-md border border-gray-200">
    <h2 class="text-2xl font-semibold text-sistema-700 mb-6 text-center">
      <%= (typeof titulo !== 'undefined' ? titulo : 'Editar Nota') %>
    </h2>

    <% if (typeof mensagem !== 'undefined' && mensagem) { %>
      <p class="text-erro-600 mb-4 text-center"><%= mensagem %></p>
    <% } %>

    <%
      // action fixo para edição (sem trocar aluno/disciplina)
      const _action = (nota?.id_disciplina && nota?.id_aluno)
        ? `/notas/${nota.id_disciplina}/${nota.id_aluno}/editar`
        : '/notas'; // fallback seguro
    %>

    <!-- Cabeçalho de contexto (somente leitura) -->
    <div class="mb-4 rounded-lg border border-neutra-200 bg-neutra-50 p-3 text-sm">
      <div class="mb-1">
        <span class="font-medium text-neutra-700">Aluno: </span>
        <span class="text-neutra-800"><%= nota?.nome_aluno || '#' + String(nota?.id_aluno || '') %></span>
      </div>
      <div>
        <span class="font-medium text-neutra-700">Disciplina: </span>
        <span class="text-neutra-800"><%= nota?.nome_disciplina || '#' + String(nota?.id_disciplina || '') %></span>
      </div>
    </div>

    <form action="<%= _action %>" method="POST" class="space-y-4">
      <!-- (opcional) mantém IDs como hidden para conferência, mas a rota usa os da URL -->
      <input type="hidden" name="id_aluno" value="<%= nota?.id_aluno %>"/>
      <input type="hidden" name="id_disciplina" value="<%= nota?.id_disciplina %>"/>

      <!-- Média -->
      <div>
        <label for="media" class="block mb-1 font-medium text-gray-700">Média</label>
        <input
          type="number" id="media" name="media" step="0.01" min="0" max="100" required
          value="<%= (nota?.media ?? '') %>"
          placeholder="Ex.: 7.50"
          class="w-full border border-neutra-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-sistema-500"
        />
        <p class="text-xs text-neutra-500 mt-1">Use ponto ou vírgula — ex.: 7.5 ou 7,5</p>
      </div>

      <!-- Faltas -->
      <div>
        <label for="nr_faltas" class="block mb-1 font-medium text-gray-700">Faltas</label>
        <input
          type="number" id="nr_faltas" name="nr_faltas" min="0" step="1" required
          value="<%= (typeof nota?.nr_faltas !== 'undefined' && nota.nr_faltas !== null) ? nota.nr_faltas : '' %>"
          placeholder="Ex.: 3"
          class="w-full border border-neutra-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-sistema-500"
        />
      </div>

      <!-- Ações -->
      <div class="flex gap-2 justify-end pt-2">
        <a href="/notas" class="bg-neutra-300 hover:bg-neutra-400 text-neutra-900 px-4 py-2 rounded transition">
          Cancelar
        </a>
        <button type="submit"
                class="bg-sistema-700 hover:bg-sistema-600 text-white px-4 py-2 rounded transition">
          Salvar alterações
        </button>
      </div>
    </form>
  </div>
</main>

<%- include('../includes/footer.ejs') %>
